using MediatR;
using Backend.PriceComparison.Application.Store.Commands.CreateCategoryStore;
using Backend.PriceComparison.Application.Store.Commands.UpdateCategoryStore;
using Backend.PriceComparison.Application.Store.Commands.DeleteCategoryStore;
using Backend.PriceComparison.Application.Store.Commands.CreateCategoryProduct;
using Backend.PriceComparison.Application.Store.Commands.UpdateCategoryProduct;
using Backend.PriceComparison.Application.Store.Commands.DeleteCategoryProduct;
using Backend.PriceComparison.Application.Store.Queries.CategoryStore;
using Backend.PriceComparison.Application.Store.Queries.CategoryProduct;
using Backend.PriceComparison.Api.Common.Wrappers;

namespace Backend.PriceComparison.Api.Endpoints;

public static class CategoryEndpoints
{
    public static void MapCategoryEndpoints(this IEndpointRouteBuilder app)
    {
        var group = app.MapGroup("/api/v1/categories").WithTags("Categories");

        // ── CategoryStore ──────────────────────────────────────────
        group.MapGet("/stores", async (
            IMediator mediator,
            int pageNumber = 1,
            int pageSize = 10,
            CancellationToken cancellationToken = default) =>
        {
            var result = await mediator.Send(
                new GetAllCategoryStoresQuery(pageNumber, pageSize), cancellationToken);

            return result.IsSuccess
                ? TypedResults.Ok(ApiResponse<object>.SuccessResponse(result.Value!))
                : TypedResults.BadRequest(ApiResponse<object>.ErrorResponse(result.Error!.Description));
        });

        group.MapGet("/stores/{id:int}", async (
            int id,
            IMediator mediator,
            CancellationToken cancellationToken) =>
        {
            var result = await mediator.Send(new GetCategoryStoreByIdQuery(id), cancellationToken);

            return result.IsSuccess
                ? TypedResults.Ok(ApiResponse<object>.SuccessResponse(result.Value!))
                : TypedResults.BadRequest(ApiResponse<object>.ErrorResponse(result.Error!.Description));
        });

        group.MapPost("/stores", async (
            CreateCategoryStoreCommand command,
            IMediator mediator,
            CancellationToken cancellationToken) =>
        {
            var result = await mediator.Send(command, cancellationToken);

            return result.IsSuccess
                ? TypedResults.Ok(ApiResponse<object>.SuccessResponse("Category store created successfully."))
                : TypedResults.BadRequest(ApiResponse<object>.ErrorResponse(result.Error!.Description));
        });

        group.MapPut("/stores/{id:int}", async (
            int id,
            UpdateCategoryStoreCommand command,
            IMediator mediator,
            CancellationToken cancellationToken) =>
        {
            var result = await mediator.Send(command with { Id = id }, cancellationToken);

            return result.IsSuccess
                ? TypedResults.Ok(ApiResponse<object>.SuccessResponse("Category store updated successfully."))
                : TypedResults.BadRequest(ApiResponse<object>.ErrorResponse(result.Error!.Description));
        });

        group.MapDelete("/stores/{id:int}", async (
            int id,
            IMediator mediator,
            CancellationToken cancellationToken) =>
        {
            var result = await mediator.Send(new DeleteCategoryStoreCommand(id), cancellationToken);

            return result.IsSuccess
                ? TypedResults.Ok(ApiResponse<object>.SuccessResponse("Category store deleted successfully."))
                : TypedResults.BadRequest(ApiResponse<object>.ErrorResponse(result.Error!.Description));
        });

        // ── CategoryProduct ────────────────────────────────────────
        group.MapGet("/products", async (
            IMediator mediator,
            int pageNumber = 1,
            int pageSize = 10,
            CancellationToken cancellationToken = default) =>
        {
            var result = await mediator.Send(
                new GetAllCategoryProductsQuery(pageNumber, pageSize), cancellationToken);

            return result.IsSuccess
                ? TypedResults.Ok(ApiResponse<object>.SuccessResponse(result.Value!))
                : TypedResults.BadRequest(ApiResponse<object>.ErrorResponse(result.Error!.Description));
        });

        group.MapGet("/products/{id:int}", async (
            int id,
            IMediator mediator,
            CancellationToken cancellationToken) =>
        {
            var result = await mediator.Send(new GetCategoryProductByIdQuery(id), cancellationToken);

            return result.IsSuccess
                ? TypedResults.Ok(ApiResponse<object>.SuccessResponse(result.Value!))
                : TypedResults.BadRequest(ApiResponse<object>.ErrorResponse(result.Error!.Description));
        });

        group.MapPost("/products", async (
            CreateCategoryProductCommand command,
            IMediator mediator,
            CancellationToken cancellationToken) =>
        {
            var result = await mediator.Send(command, cancellationToken);

            return result.IsSuccess
                ? TypedResults.Ok(ApiResponse<object>.SuccessResponse("Category product created successfully."))
                : TypedResults.BadRequest(ApiResponse<object>.ErrorResponse(result.Error!.Description));
        });

        group.MapPut("/products/{id:int}", async (
            int id,
            UpdateCategoryProductCommand command,
            IMediator mediator,
            CancellationToken cancellationToken) =>
        {
            var result = await mediator.Send(command with { Id = id }, cancellationToken);

            return result.IsSuccess
                ? TypedResults.Ok(ApiResponse<object>.SuccessResponse("Category product updated successfully."))
                : TypedResults.BadRequest(ApiResponse<object>.ErrorResponse(result.Error!.Description));
        });

        group.MapDelete("/products/{id:int}", async (
            int id,
            IMediator mediator,
            CancellationToken cancellationToken) =>
        {
            var result = await mediator.Send(new DeleteCategoryProductCommand(id), cancellationToken);

            return result.IsSuccess
                ? TypedResults.Ok(ApiResponse<object>.SuccessResponse("Category product deleted successfully."))
                : TypedResults.BadRequest(ApiResponse<object>.ErrorResponse(result.Error!.Description));
        });
    }
}
